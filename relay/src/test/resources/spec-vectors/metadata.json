  {"name": "request, canonical in is canonical out", "input": "{\"headers\":{\"accept\":\"application/json\",\"set-cookie\":[\"a=1\",\"b=2\"]},\"method\":\"GET\",\"path\":\"api/users?page=2\",\"v\":2}", "canonical": "{\"headers\":{\"accept\":\"application/json\",\"set-cookie\":[\"a=1\",\"b=2\"]},\"method\":\"GET\",\"path\":\"api/users?page=2\",\"v\":2}"},
  {"name": "response", "input": "{\"headers\":{\"content-type\":\"text/plain\"},\"status\":204,\"v\":2}", "canonical": "{\"headers\":{\"content-type\":\"text/plain\"},\"status\":204,\"v\":2}"},
