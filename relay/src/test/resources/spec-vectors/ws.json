    {"name": "length 0 DATA carrying nothing on tcp", "kind": 2, "flags": 0, "length": 0, "transport": "tcp"},
    {"name": "length 0 DATA carrying half on tcp", "kind": 2, "flags": 8, "length": 0, "transport": "tcp", "error": "payload"},

    {"name": "a fragment", "kind": 2, "flags": 2, "length": 1024, "transport": "ws"},
    {"name": "a text fragment", "kind": 2, "flags": 6, "length": 1024, "transport": "ws"},
    {"name": "a text run terminator", "kind": 2, "flags": 4, "length": 12, "transport": "ws"},
    {"name": "more on http", "kind": 2, "flags": 2, "length": 8, "transport": "http", "error": "payload"},
