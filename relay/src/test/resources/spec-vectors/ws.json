{
  "_": "Frame version 2 on the WebSocket transport. Every case here is a rule that was found missing rather than a rule that was already held: the flag rules of errata E1 and E2, the one frame per message mapping, the fragment run of E3, and the close code mapping of W10 and W10a. Kinds and flag bits are the numeric values from spec/registry.md. Transports are the three names wire.Transport prints.",

  "flags": [
    {"name": "end and more together on a ws DATA", "kind": 2, "flags": 3, "length": 8, "transport": "ws", "error": "payload"},
    {"name": "end and more together on an http DATA", "kind": 2, "flags": 3, "length": 8, "transport": "http", "error": "payload"},
    {"name": "end and more together on a tcp DATA", "kind": 2, "flags": 3, "length": 8, "transport": "tcp", "error": "payload"},
    {"name": "end alone on a ws DATA", "kind": 2, "flags": 1, "length": 8, "transport": "ws", "error": "payload"},
    {"name": "end alone on a ws REQUEST", "kind": 0, "flags": 1, "length": 40, "transport": "ws", "error": "payload"},
    {"name": "end alone on a ws RESPONSE", "kind": 1, "flags": 1, "length": 12, "transport": "ws", "error": "payload"},
    {"name": "end and text together on a ws DATA", "kind": 2, "flags": 5, "length": 8, "transport": "ws", "error": "payload"},
    {"name": "end on a ws CLOSE", "kind": 6, "flags": 1, "length": 7, "transport": "ws", "error": "payload"},
    {"name": "end on an http DATA", "kind": 2, "flags": 1, "length": 8, "transport": "http"},
    {"name": "end on an http REQUEST", "kind": 0, "flags": 1, "length": 40, "transport": "http"},
    {"name": "end on an http RESPONSE", "kind": 1, "flags": 1, "length": 12, "transport": "http"},
    {"name": "end on a tcp DATA", "kind": 2, "flags": 1, "length": 8, "transport": "tcp"},
    {"name": "end on a tcp REQUEST", "kind": 0, "flags": 1, "length": 40, "transport": "tcp"},
    {"name": "end on a tcp RESPONSE", "kind": 1, "flags": 1, "length": 12, "transport": "tcp"},

    {"name": "length 0 DATA carrying more", "kind": 2, "flags": 2, "length": 0, "transport": "ws", "error": "payload"},
    {"name": "length 0 DATA carrying text", "kind": 2, "flags": 4, "length": 0, "transport": "ws", "error": "payload"},
    {"name": "length 0 DATA carrying more and text", "kind": 2, "flags": 6, "length": 0, "transport": "ws", "error": "payload"},
