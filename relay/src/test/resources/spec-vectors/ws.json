  "messages": [
    {"name": "one DATA frame and nothing else", "hex": "894d5402020000000000000568656c6c6f", "expect": {"kind": 2, "flags": 0, "length": 5, "payload": "68656c6c6f"}},
    {"name": "a length 0 DATA is exactly the envelope", "hex": "894d54020200000000000000", "expect": {"kind": 2, "flags": 0, "length": 0, "payload": ""}},
    {"name": "a text fragment", "hex": "894d5402020600000000000368656c", "expect": {"kind": 2, "flags": 6, "length": 3, "payload": "68656c"}},
    {"name": "one byte short of the declared length", "hex": "894d5402020000000000000568656c6c", "error": "message_length"},
    {"name": "one byte of padding after the frame", "hex": "894d5402020000000000000568656c6c6f00", "error": "message_length"},
    {"name": "two frames in one message", "hex": "894d54020200000000000000894d54020200000000000000", "error": "message_length"},
    {"name": "a length 5 frame carrying no payload", "hex": "894d54020200000000000005", "error": "message_length"},
    {"name": "eleven bytes", "hex": "894d540202000000000000", "error": "short"},
    {"name": "empty message", "hex": "", "error": "short"},
    {"name": "over max_frame_bytes", "hex": "894d5402020000000000000568656c6c6f", "max_frame_bytes": 4, "error": "too_large"},
    {"name": "exactly max_frame_bytes", "hex": "894d5402020000000000000568656c6c6f", "max_frame_bytes": 5, "expect": {"kind": 2, "flags": 0, "length": 5, "payload": "68656c6c6f"}},
    {"name": "the length bound is checked before the message length", "hex": "894d540202000000ffffffff", "max_frame_bytes": 4096, "error": "too_large"},
    {"name": "END on a ws DATA, once the envelope is whole", "hex": "894d5402020100000000000568656c6c6f", "error": "payload"},
    {"name": "END and MORE on a ws DATA, once the envelope is whole", "hex": "894d5402020300000000000568656c6c6f", "error": "payload"},
    {"name": "a length 0 DATA carrying TEXT, once the envelope is whole", "hex": "894d54020204000000000000", "error": "payload"}
  ],

  "runs": [
    {
      "name": "three fragments of one text message",
      "frames": [
        {"flags": 6, "app": "68656c"},
        {"flags": 6, "app": "6c6f20"},
        {"flags": 4, "app": "776f726c64"}
      ],
      "expect": {"text": true, "app": "68656c6c6f20776f726c64", "fragments": 3, "messages": 1}
    },
    {
      "name": "two fragments of one binary message",
      "frames": [
        {"flags": 2, "app": "00ff"},
        {"flags": 0, "app": "01"}
      ],
      "expect": {"text": false, "app": "00ff01", "fragments": 2, "messages": 1}
    },
    {
      "name": "an unfragmented text message is a run of one",
      "frames": [
        {"flags": 4, "app": "6f6b"}
      ],
      "expect": {"text": true, "app": "6f6b", "fragments": 1, "messages": 1}
    },
    {
      "name": "a length 0 DATA before a run is a heartbeat",
      "frames": [
        {"flags": 0, "app": ""},
        {"flags": 2, "app": "6162"},
        {"flags": 0, "app": "63"}
      ],
      "expect": {"text": false, "app": "616263", "fragments": 2, "messages": 1}
    },
    {
      "name": "a length 0 DATA inside a run truncates the message",
      "frames": [
        {"flags": 6, "app": "68656c"},
        {"flags": 0, "app": ""},
        {"flags": 4, "app": "6c6f"}
      ],
      "error": "empty_in_run"
    },
    {
      "name": "text cleared inside a run",
      "frames": [
        {"flags": 6, "app": "68656c"},
        {"flags": 2, "app": "6c6f"}
      ],
      "error": "text_changed"
    },
    {
      "name": "text set inside a run",
      "frames": [
        {"flags": 2, "app": "00ff"},
        {"flags": 4, "app": "01"}
      ],
      "error": "text_changed"
    }
  ],

