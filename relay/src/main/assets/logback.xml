<configuration>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/logs/relay.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="LOGCAT" class="ch.qos.logback.classic.android.LogcatAppender">
        <tagEncoder>
            <pattern>MTE</pattern>
        </tagEncoder>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Default minimum level. INFO keeps production quiet (errors, warnings and
        lifecycle breadcrumbs only) so debug/trace cost nothing at runtime.
        For field diagnostics raise it without a rebuild:
            LogHelper.setMinimumLevel("DEBUG");   // or "TRACE"
        See dev_docs/LOGGING_CONVENTION.md §1 and §4.
    -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="LOGCAT"/>
    </root>

</configuration>
